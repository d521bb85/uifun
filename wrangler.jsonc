{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uifun",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "ui.ivanen.co",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}

{
  "name": "uifun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "lefthook install",
    "dev": "vite",
    "check": "tsc --noEmit && biome check .",
    "fix": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "build": "vite build",
    "preview": "vite preview",
    "cf:dev": "vite build && wrangler dev",
    "release": "pnpm run check && pnpm run test && vite build && wrangler deploy",
    "deploy": "vite build && wrangler deploy",
    "rollback": "wrangler rollback"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@ui-sdk/core": "0.1.0-beta.16",
    "@ui-sdk/react": "0.1.0-beta.16",
    "clsx": "^2.1.1",
    "lucide-react": "^1.79.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.3.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.167.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
